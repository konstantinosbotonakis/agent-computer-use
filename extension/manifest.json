{
  "manifest_version": 3,
  "name": "Agent Computer Use",
  "version": "0.2.1",
  "description": "Lets local coding agents work in background tabs of your Chrome, grouped per task, without remote debugging.",
  "homepage_url": "https://github.com/konstantinosbotonakis/agent-computer-use",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "debugger",
    "nativeMessaging",
    "tabGroups",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Agent Computer Use",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "popup.html"
  }
}
